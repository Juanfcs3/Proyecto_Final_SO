{
  "uid": "infraestructura-so",
  "title": "Infraestructura Docker",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por backend",
      "description": "Solicitudes a / por segundo, agrupadas por instancia.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(backend_http_requests_total[$__rate_interval])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 por backend",
      "description": "Tiempo de ejecución de / dentro de Flask. El panel queda sin muestra cuando no hay solicitudes en el intervalo.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * (histogram_quantile(0.95, rate(backend_http_request_duration_seconds_bucket[$__rate_interval])) and on(instance) (rate(backend_http_request_duration_seconds_count[$__rate_interval]) > 0))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Conexiones de Nginx",
      "description": "Conexiones activas e inactivas en espera según stub_status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "legendFormat": "Activas"
        },
        {
          "refId": "B",
          "expr": "nginx_connections_waiting",
          "legendFormat": "En espera"
        }
      ]
    },
    {
      "id": 4,
      "title": "Solicitudes en Nginx",
      "description": "Incluye las consultas periódicas del exportador a stub_status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[$__rate_interval])",
          "legendFormat": "Nginx"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU por contenedor",
      "description": "Segundos de CPU usados por segundo. El valor 1 corresponde a un núcleo ocupado.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memoria por contenedor",
      "description": "Memoria de trabajo por servicio.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Tráfico de red por contenedor",
      "description": "Bytes recibidos y enviados por segundo.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_receive_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}} RX"
        },
        {
          "refId": "B",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}} TX"
        }
      ]
    },
    {
      "id": 8,
      "title": "E/S de disco por contenedor",
      "description": "Lecturas y escrituras por segundo. Algunas series aparecen tras la primera actividad de disco.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_fs_reads_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}} lectura"
        },
        {
          "refId": "B",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_fs_writes_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"proyecto-final-so\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}} escritura"
        }
      ]
    }
  ]
}
